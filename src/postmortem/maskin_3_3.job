#!/bin/bash
#SBATCH --job-name=MaskIn
#SBATCH --time=12:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --output=../../results/postmortem_3_3/maskin/logs/%x_%j.log
#SBATCH --error=../../results/postmortem_3_3/maskin/logs/%x_%j.err

# Mask-input ablation (3.3). Submit: sbatch --account=<acc> --job-name=MaskIn_s<seed> --export=ALL,SEED=<seed> maskin_3_3.job
PY=/home/sarro/SummerProj/envSummer1_conda/bin/python
OUT=../../results/postmortem_3_3/maskin/s${SEED}
$PY -u time_comparison_3_3.py --mode random --maskin --seed "$SEED" --epochs 60 --sparsity 0.70 --noise-std 0.005 --out "$OUT"
