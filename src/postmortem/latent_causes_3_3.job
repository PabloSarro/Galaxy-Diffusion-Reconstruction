#!/bin/bash
#SBATCH --job-name=PM33lat
#SBATCH --time=01:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --account=env540
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --output=../../results/postmortem_3_3/latent_job_%j.log
#SBATCH --error=../../results/postmortem_3_3/latent_job_%j.err

# Task 3.3: latent DDPM causes (encoder probe, retrieval, data scale). Run from src/postmortem/.
PY=/home/sarro/SummerProj/envSummer1_conda/bin/python
echo "host=$(hostname) date=$(date)"
$PY -u latent_causes_3_3.py
echo "done $(date)"
