#!/bin/bash
#SBATCH --job-name=Phys31
#SBATCH --time=03:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --account=cs-302
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --output=../results/split_v1/physics/job_%j.log
#SBATCH --error=../results/split_v1/physics/job_%j.err

# Task 3.1: chi, Kaiser-Squires kappa and power-spectrum metrics at matched sigma, VALID split.
PY=/home/sarro/SummerProj/envSummer1_conda/bin/python
echo "host=$(hostname) date=$(date)"
$PY -u physics_metrics.py --output ../results/split_v1/physics/physics_valid.json
echo "done $(date)"
