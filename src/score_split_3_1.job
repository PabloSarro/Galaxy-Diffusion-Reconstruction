#!/bin/bash
#SBATCH --job-name=Score31
#SBATCH --time=01:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=32G
#SBATCH --account=env540
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --output=../results/split_v1/job_%j.log
#SBATCH --error=../results/split_v1/job_%j.err

# Task 3.1: re-score Models 1-3 per class on the VALID split only (test split is not read yet).
PY=/home/sarro/SummerProj/envSummer1_conda/bin/python
R=../results
SPLIT=$R/splits/split_v1.json
echo "host=$(hostname) date=$(date)"; nvidia-smi --query-gpu=name --format=csv,noheader
declare -A SIGMA=( [1]=0.005 [2]=0 [3]=0.22 )
for M in 1 2 3; do
  $PY -u eval_pixel.py --decoder-path "$R/Reconstruction/Model $M/MSE/training/decoder_best.pt" \
      --output-dir "$R/split_v1/Model $M" --noise-std ${SIGMA[$M]} --split-file $SPLIT --split valid
done
echo "done $(date)"
