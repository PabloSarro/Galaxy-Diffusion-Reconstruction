#!/bin/bash
#SBATCH --job-name=B1close
#SBATCH --time=02:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --output=../results/B1/closing/job_%j.log
#SBATCH --error=../results/B1/closing/job_%j.err

# Task 3.2 closing: full-valid scoring, mean/spread table, B1 golden, weight backup. No test read.
PY=/home/sarro/SummerProj/envSummer1_conda/bin/python
mkdir -p ../results/B1/closing
echo "host=$(hostname) date=$(date)"
$PY -u b1_closing.py
echo "done $(date)"
